{
  "name": "encapsulated-css-loader",
  "description": "A Webpack loader to encapsulate CSS with a given class name to prevent styles from leaking between modules.",
  "version": "2.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/01taylop/encapsulated-css-loader.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rimraf lib && rollup -c",
    "prepublish": "yarn test --coverage && yarn build && yarn test:integration",
    "release": "changeset publish",
    "test": "jest src/",
    "test:integration": "yarn node --experimental-vm-modules $(yarn bin jest) tests/"
  },
  "dependencies": {
    "schema-utils": "^4.8.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/jest": "30.0.0",
    "@types/node": "18.19.130",
    "css-loader": "7.1.5",
    "jest": "30.5.2",
    "knip": "6.45.1",
    "rimraf": "6.1.4",
    "rollup": "4.68.3",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "webpack": "5.112.2"
  },
  "author": "Patrick Taylor <hello@patricktaylor.dev>",
  "keywords": [
    "css",
    "encapsulated",
    "isolation",
    "loader",
    "scoped",
    "scss",
    "styles",
    "webpack"
  ],
  "license": "MIT",
  "packageManager": "yarn@4.19.0"
}
